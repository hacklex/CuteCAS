module Core.Polynomial.Lagrange  (* ================================================================ *) (*  Lagrange interpolation basis and its delta (node-evaluation)    *) (*  property over a generic field.                                   *) (*                                                                   *) (*  For distinct nodes  cs = [c_0; ...; c_{n-1}]  define             *) (*    numer_j = prod_{m != j} (X - c_m)                              *) (*    denom_j = prod_{m != j} (c_j - c_m)   (a nonzero constant)     *) (*    basis_j = (inv denom_j) . numer_j                              *) (*  Then  basis_j(c_k) = (if j = k then one else zero).             *) (* ================================================================ *)  module L  = FStar.List.Tot module H  = Core.Algebra.Helpers  open Core.Algebra open Core.Algebra.Notation open Core.Polynomial open Core.Polynomial.Eval open Core.Polynomial.Roots  #set-options "--fuel 1 --ifuel 1 --z3rlimit 40"  (* ---------------------------------------------------------------- *) (*  Evaluation of a constant-scaled polynomial.                      *) (*    poly_eval (poly_scale a p) c = a * poly_eval p c               *) (*  (poly_scale a p = poly_mul (a @ poly_zero) p, so eval_mul +      *) (*   eval of the singleton constant gives the result.)               *) (* ---------------------------------------------------------------- *)  let eval_scale (#t:Type) {| f: field t |} (a: t) (p: polynomial t) (c: t)   : Lemma (poly_eval (poly_scale #t a p) c = a * poly_eval p c)   = H.elim_equatable_laws t ();     H.trans_for_calc t ();     (* poly_scale a p = poly_mul (a @ poly_zero) p *)     eval_mul (a @ poly_zero) p c;     (* poly_eval (a @ poly_zero) c = a *)     let _ : squash (poly_eval (a @ poly_zero) c = a) =       if a = (zero <: t) then         eval_zero #t c       else         eval_singleton #t #f a c in     mul_congruence (poly_eval (a @ poly_zero) c) (poly_eval p c) a (poly_eval p c)  (* ---------------------------------------------------------------- *) (*  Index-based removal of the j-th element from a list.             *) (* ---------------------------------------------------------------- *)  let rec delete_index (#t:Type) (cs: list t) (j: nat{j < L.length cs})   : Tot (list t) (decreases cs)   = match cs with     | x :: rest -> if j = 0 then rest else x :: delete_index rest (j - 1)  (* length of the deleted list drops by one *) let rec delete_index_length (#t:Type) (cs: list t) (j: nat{j < L.length cs})   : Lemma (ensures L.length (delete_index cs j) == L.length cs - 1)           (decreases cs)   = match cs with     | x :: rest -> if j = 0 then () else delete_index_length rest (j - 1)  (* every element of (delete_index cs j) is a member of cs *) let rec delete_index_memP (#t:Type) (cs: list t) (j: nat{j < L.length cs}) (y: t)   : Lemma (requires L.memP y (delete_index cs j))           (ensures  L.memP y cs)           (decreases cs)   = match cs with     | x :: rest ->       if j = 0 then ()       else begin         (* delete_index (x::rest) j = x :: delete_index rest (j-1) *)         eliminate (y == x) \/ (L.memP y (delete_index rest (j - 1)))         returns L.memP y cs         with _h. ()         and  _h. delete_index_memP rest (j - 1) y       end  (* For k <> j, the k-th element of cs survives in (delete_index cs j). *) let rec delete_index_keeps_other (#t:Type) (cs: list t) (j k: nat{j < L.length cs /\ k < L.length cs})   : Lemma (requires not (j = k))           (ensures  L.memP (L.index cs k) (delete_index cs j))           (decreases cs)   = match cs with     | x :: rest ->       if j = 0 then begin         (* delete_index cs 0 = rest; k <> 0 so index cs k = index rest (k-1), which is in rest *)         L.lemma_index_memP rest (k - 1)       end       else if k = 0 then         (* index cs 0 = x, and delete_index (x::rest) j = x :: ...  so x is a member *)         ()       else begin         (* both j,k > 0: index cs k = index rest (k-1); recurse on rest *)         delete_index_keeps_other rest (j - 1) (k - 1)       end  (* ---------------------------------------------------------------- *) (*  Distinctness: index cs j differs from every element of the rest. *) (*    From all_distinct, the j-th element is distinct from every     *) (*    other element, hence from every element of (delete_index cs j).*) (* ---------------------------------------------------------------- *)  (* If all_distinct cs and y is a member of (delete_index cs j),    then index cs j <> y.  Proved by induction following delete_index. *) let rec index_j_differs (#t:Type) {| f: field t |} (cs: list t) (j: nat{j < L.length cs}) (y: t)   : Lemma (requires all_distinct #t cs /\ L.memP y (delete_index cs j))           (ensures  not (L.index cs j = y))           (decreases cs)   = match cs with     | x :: rest ->       (* all_distinct (x::rest) = (forall d. memP d rest ==> not (x = d)) /\ all_distinct rest *)       if j = 0 then begin         (* index cs 0 = x; y is a member of (delete_index cs 0) = rest, so memP y rest;            all_distinct head gives not (x = y). *)         assert (forall (d:t). L.memP d rest ==> not (x = d))       end       else begin         (* index cs j = index rest (j-1); y in delete_index (x::rest) j = x :: delete_index rest (j-1). *)         H.elim_equatable_laws t ();         eliminate (y == x) \/ (L.memP y (delete_index rest (j - 1)))         returns not (L.index cs j = y)         with _heq. begin           (* y == x.  index cs j = index rest (j-1), a member of rest, so all_distinct head: not(x = that). *)           L.lemma_index_memP rest (j - 1);                (* memP (index rest (j-1)) rest *)           assert (forall (d:t). L.memP d rest ==> not (x = d));           assert (not (x = L.index rest (j - 1)));           (* goal: not (index rest (j-1) = y); y == x so need not (index rest (j-1) = x) *)           symmetry x (L.index rest (j - 1))               (* not (index rest (j-1) = x) *)         end         and  _h. index_j_differs rest (j - 1) y       end  (* ---------------------------------------------------------------- *) (*  The denominator  prod_{m in delete_index cs j} (c_j - c_m)       *) (*  is nonzero when cs is distinct.                                  *) (*  (eval_prod_sub roots c = prod (neg c_m + c) over roots.)         *) (* ---------------------------------------------------------------- *)  (* If cj differs from every element of the list `roots`, then    eval_prod_sub roots cj is nonzero. *) let rec eval_prod_sub_nonzero (#t:Type) {| f: field t |} (roots: list t) (cj: t)   : Lemma (requires (forall (m:t). L.memP m roots ==> not (cj = m)))           (ensures  not (eval_prod_sub #t #f roots cj = (zero <: t)))           (decreases roots)   = H.elim_equatable_laws t ();     match roots with     | []        ->       (* eval_prod_sub [] cj = one, nonzero *)       f.f_one_ne_zero     | a :: rest ->       (* eval_prod_sub (a::rest) cj = (neg a + cj) * eval_prod_sub rest cj *)       (* head: memP a (a::rest) so not (cj = a); sub_nonzero_of_distinct gives (neg a + cj) <> 0 *)       assert (L.memP a (a :: rest));       assert (not (cj = a));       sub_nonzero_of_distinct #t #f a cj;                 (* not ((neg a + cj) = zero) *)       (* tail nonzero by IH *)       eval_prod_sub_nonzero rest cj;       (* domain: product of two nonzero elements is nonzero *)       let id : integral_domain t = id_of_f t in       domain_nonzero_mul_nonzero #t #(id.id_d) ((- a) + cj) (eval_prod_sub #t #f rest cj)  (* ---------------------------------------------------------------- *) (*  The Lagrange numerator, denominator, and basis.                  *) (* ---------------------------------------------------------------- *)  (* numerator: prod_{m != j} (X - c_m) *) let lagrange_numer (#t:Type) {| f: field t |} (cs: list t) (j: nat{j < L.length cs})   : polynomial t   = poly_prod_linears #t #f (delete_index cs j)  (* denominator: prod_{m != j} (c_j - c_m), evaluated form *) let lagrange_denom (#t:Type) {| f: field t |} (cs: list t) (j: nat{j < L.length cs})   : t   = eval_prod_sub #t #f (delete_index cs j) (L.index cs j)  (* the denominator is nonzero for distinct nodes *) let lagrange_denom_nonzero (#t:Type) {| f: field t |} (cs: list t) (j: nat{j < L.length cs})   : Lemma (requires all_distinct #t cs)           (ensures  not (lagrange_denom #t #f cs j = (zero <: t)))   = (* every element of (delete_index cs j) differs from index cs j *)     let cj = L.index cs j in     let aux (m:t) : Lemma (L.memP m (delete_index cs j) ==> not (cj = m)) =       introduce L.memP m (delete_index cs j) ==> not (cj = m)       with _hm. index_j_differs #t #f cs j m     in     FStar.Classical.forall_intro aux;     eval_prod_sub_nonzero #t #f (delete_index cs j) cj  (* basis: (inv denom) . numer *) let lagrange_basis (#t:Type) {| f: field t |} (cs: list t)                    (j: nat{j < L.length cs}){| _: squash (all_distinct #t cs) |}   : polynomial t   = lagrange_denom_nonzero #t #f cs j;     let d = lagrange_denom #t #f cs j in     let invd = (f.f_sf.sf_mig).inv d in     poly_scale #t invd (lagrange_numer #t #f cs j)  (* ---------------------------------------------------------------- *) (*  Diagonal case:  basis_j (c_j) = one.                             *) (* ---------------------------------------------------------------- *)  let lagrange_basis_diag (#t:Type) {| f: field t |} (cs: list t)                         (j: nat{j < L.length cs}){| sq: squash (all_distinct #t cs) |}   : Lemma (ensures poly_eval (lagrange_basis #t #f cs j) (L.index cs j) = (one <: t))   = H.elim_equatable_laws t ();     H.trans_for_calc t ();     lagrange_denom_nonzero #t #f cs j;     let cj = L.index cs j in     let numer = lagrange_numer #t #f cs j in     let d = lagrange_denom #t #f cs j in     let invd = (f.f_sf.sf_mig).inv d in     (* eval numer cj = eval_prod_sub (delete_index cs j) cj = d *)     eval_poly_prod_linears #t #f (delete_index cs j) cj;       (* eval numer cj = d *)     (* eval basis cj = invd * eval numer cj *)     eval_scale #t #f invd numer cj;     (* invd * eval numer cj = invd * d *)     mul_congruence invd (poly_eval numer cj) invd d;     (* invd * d = one *)     (f.f_sf.sf_mig).inversion_lemma d  (* ---------------------------------------------------------------- *) (*  Off-diagonal case:  basis_j (c_k) = zero  for k <> j.            *) (* ---------------------------------------------------------------- *)  let lagrange_basis_offdiag (#t:Type) {| f: field t |} (cs: list t)                            (j k: nat{j < L.length cs /\ k < L.length cs}){| sq: squash (all_distinct #t cs) |}   : Lemma (requires not (j = k))           (ensures poly_eval (lagrange_basis #t #f cs j) (L.index cs k) = (zero <: t))   = H.elim_equatable_laws t ();     H.trans_for_calc t ();     lagrange_denom_nonzero #t #f cs j;     let ck = L.index cs k in     let numer = lagrange_numer #t #f cs j in     let d = lagrange_denom #t #f cs j in     let invd = (f.f_sf.sf_mig).inv d in     (* ck is one of the roots of numer (k <> j => index cs k in delete_index cs j) *)     delete_index_keeps_other #t cs j k;                        (* memP ck (delete_index cs j) *)     prod_linears_vanishes #t #f (delete_index cs j) ck;        (* eval numer ck = zero *)     (* eval basis ck = invd * eval numer ck *)     eval_scale #t #f invd numer ck;     (* invd * eval numer ck = invd * zero *)     mul_congruence invd (poly_eval numer ck) invd (zero <: t);     (* invd * zero = zero *)     H.x_mul_zero invd  (* ---------------------------------------------------------------- *) (*  The delta property, combining both cases.                        *) (* ---------------------------------------------------------------- *)  let lagrange_delta_value (#t:Type) {| f: field t |} (j k: nat) : t =   if j = k then (one <: t) else (zero <: t)  let lagrange_basis_delta (#t:Type) {| f: field t |} (cs: list t)                          (j k: nat{j < L.length cs /\ k < L.length cs}){| sq: squash (all_distinct #t cs) |}   : Lemma (ensures poly_eval (lagrange_basis #t #f cs j) (L.index cs k)                    = lagrange_delta_value #t #f j k)   = if j = k then begin       (* index cs k = index cs j *)       lagrange_basis_diag #t #f cs j #sq     end     else       lagrange_basis_offdiag #t #f cs j k #sq 