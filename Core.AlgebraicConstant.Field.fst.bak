module Core.AlgebraicConstant.Field

(* Prereq C: algebraic t r is a FIELD when r is irreducible.
   inverse of [a] (a not div by r) = [snd (normalize_bezout r a)]. *)

module TC = FStar.Tactics.Typeclasses
module H  = Core.Algebra.Helpers

open Core.Algebra
open Core.Algebra.Notation
open Core.Algebra.Divisibility
open Core.Polynomial
open Core.Polynomial.Div
open Core.Polynomial.GCD
open Core.Polynomial.PartialFraction
open Core.Polynomial.Irreducible
open Core.Polynomial.Unique
open Core.AlgebraicConstant

(* An irreducible r (deg >= 1) does not divide 1. *)
let r_not_divides_one (#t:Type) {| f: field t |} (r: polynomial t)
  : Lemma (requires poly_irreducible r)
          (ensures  ~(divides r poly_one))
  = let aux () : Lemma (requires divides r poly_one)
                       (ensures False)
      = divides_degree_le r poly_one (* deg r <= deg 1 = 0, but deg r >= 1 *)
    in Classical.move_requires aux ()

(* Not divisible by r  =>  a is a nonzero polynomial (Some degree). *)
let deg_some_of_not_div (#t:Type) {| f: field t |} (r a: polynomial t)
  : Lemma (requires (let cr_p : commutative_ring (polynomial t) = TC.solve in
                     ~(divides #(polynomial t) #cr_p r a)))
          (ensures  Some? (poly_deg a))
  = let cr_p : commutative_ring (polynomial t) = TC.solve in
    H.elim_equatable_laws (polynomial t) ();
    H.trans_for_calc (polynomial t) ();
    let aux () : Lemma (requires None? (poly_deg a))
                       (ensures divides #(polynomial t) #cr_p r a)
      = degree_none_poly_eq_zero a;                  (* a ~ poly_zero *)
        divides_zero #(polynomial t) #cr_p r;        (* r | poly_zero *)
        poly_eq_symmetry (poly_zero #t) a;
        divides_congruence_right #(polynomial t) #cr_p r (poly_zero #t) a
    in
    Classical.move_requires aux ()

(* Bridges between ac_eq-to-zero (= is_nonzero, once the ring is fixed) and
   ~(divides r rep).  Both follow directly from the public characterization
   ac_eq_zero_iff_divides. *)
let not_div_of_nonzero (#t:Type) {| f: field t |} (#r: polynomial t {Some? (poly_deg r)})
  (x: algebraic t r)
  : Lemma (requires not (ac_eq x (ac_zero #t #f #r)))
          (ensures (let cr_p : commutative_ring (polynomial t) = TC.solve in
                    ~(divides #(polynomial t) #cr_p r x.ac_rep)))
  = ac_eq_zero_iff_divides x

let nonzero_of_not_div (#t:Type) {| f: field t |} (#r: polynomial t {Some? (poly_deg r)})
  (a: polynomial t)
  : Lemma (requires (let cr_p : commutative_ring (polynomial t) = TC.solve in
                     ~(divides #(polynomial t) #cr_p r a)))
          (ensures  not (ac_eq ({ ac_rep = a } <: algebraic t r) (ac_zero #t #f #r)))
  = ac_eq_zero_iff_divides ({ ac_rep = a } <: algebraic t r)

(* ================================================================ *)
(*  Inverse in the algebraic field:  inv [a] = [bezout_right r a].  *)
(*  For coprime r a (a not divisible by irreducible r), Bezout gives *)
(*    bezout_left*r + bezout_right*a ~ 1,  so  a*bezout_right ~ 1 (mod r). *)
(* ================================================================ *)

let ac_inv (#t:Type) {| f: field t |} (#r: polynomial t {Some? (poly_deg r)})
  (x: algebraic t r)
  : Pure (algebraic t r)
         (requires poly_irreducible r /\ not (ac_eq x (ac_zero #t #f #r)))
         (ensures  fun y -> not (ac_eq y (ac_zero #t #f #r)) /\
                         coprime #t #f r x.ac_rep /\
                         y.ac_rep == bezout_right #t #f r x.ac_rep)
  = let cr_p : commutative_ring (polynomial t) = TC.solve in
    H.elim_equatable_laws (polynomial t) ();
    H.trans_for_calc (polynomial t) ();
    let a = x.ac_rep in
    not_div_of_nonzero x;                     (* ~(divides r a) *)
    deg_some_of_not_div r a;                  (* Some? (poly_deg a) *)
    irreducible_coprime_or_divides r a;       (* coprime r a \/ divides r a => coprime r a *)
    let br = bezout_right #t #f r a in
    let bl = bezout_left  #t #f r a in
    let y : algebraic t r = { ac_rep = br } in
    (* br is itself not divisible by r: else r | (bl*r + br*a) ~ 1. *)
    let aux () : Lemma (requires divides #(polynomial t) #cr_p r br) (ensures False)
      = bezout_identity #t #f r a;                                  (* (bl*r + br*a) ~ 1 *)
        divides_refl       #(polynomial t) #cr_p r;                 (* r | r *)
        divides_mul_left   #(polynomial t) #cr_p r bl r;            (* r | bl*r *)
        divides_mul_right  #(polynomial t) #cr_p r br a;            (* r | br*a *)
        divides_add        #(polynomial t) #cr_p r (poly_mul bl r) (poly_mul br a);
        divides_congruence_right #(polynomial t) #cr_p r
          (poly_add (poly_mul bl r) (poly_mul br a)) (poly_one #t); (* r | 1 *)
        r_not_divides_one  #t #f r
    in
    Classical.move_requires aux ();                                 (* ~(divides r br) *)
    nonzero_of_not_div #t #f #r br;                                 (* not (ac_eq y ac_zero) *)
    y

(* ================================================================ *)
(*  Inversion identity:  [a] * [bezout_right r a] = [1]  in the     *)
(*  quotient (and symmetrically), for irreducible r and a not 0.    *)
(* ================================================================ *)

(* Pure ring identities (standalone so canon_ring sees no opaque locals). *)
let add_neg_self (#u:Type) {| cr: commutative_ring u |} (w: u)
  : Lemma (eq (add w (neg w)) (zero #u))
  = assert (eq (add w (neg w)) (zero #u))
      by Core.Tactics.CanonRing.canon_ring ()

(* z - o  =  (-y) + ((y + z) - o)   *)
let residue_id (#u:Type) {| cr: commutative_ring u |} (y z o: u)
  : Lemma (eq (add z (neg o))
              (add (neg y) (add (add y z) (neg o))))
  = assert (eq (add z (neg o))
               (add (neg y) (add (add y z) (neg o))))
      by Core.Tactics.CanonRing.canon_ring ()

let ac_inv_correct (#t:Type) {| f: field t |} (#r: polynomial t {Some? (poly_deg r)})
  (x: algebraic t r)
  : Lemma (requires poly_irreducible r /\ not (ac_eq x (ac_zero #t #f #r)))
          (ensures  ac_eq (ac_mul x (ac_inv x)) (ac_one #t #f #r) /\
                    ac_eq (ac_mul (ac_inv x) x) (ac_one #t #f #r))
  = let cr_p : commutative_ring (polynomial t) = TC.solve in
    H.elim_equatable_laws (polynomial t) ();
    H.trans_for_calc (polynomial t) ();
    let a   = x.ac_rep in
    let inv = ac_inv x in
    let br  = inv.ac_rep in                                  (* == bezout_right r a *)
    let bl  = bezout_left #t #f r a in
    let yv  = poly_mul bl r in
    let zv  = poly_mul br a in
    let onep = poly_one #t in
    (* expose the abstract operation reps *)
    ac_mul_rep x inv;                                        (* (x*inv).rep == poly_mul a br *)
    ac_mul_rep inv x;                                        (* (inv*x).rep == poly_mul br a = zv *)
    ac_one_rep #t #f #r;                                     (* one.rep == poly_one *)
    bezout_identity #t #f r a;                               (* eq (add yv zv) one *)
    (* r | yv  and  r | neg yv *)
    divides_refl     #(polynomial t) #cr_p r;
    divides_mul_left #(polynomial t) #cr_p r bl r;
    divides_neg      #(polynomial t) #cr_p r yv;
    (* (add yv zv) - one ~ zero,  hence r | ((add yv zv) - one) *)
    reflexivity #(polynomial t) #(cr_p.cr_r.r_add.acg_eq) (poly_neg onep);
    add_neg_self #(polynomial t) #cr_p onep;                 (* eq (add one (neg one)) zero *)
    poly_add_congruence (poly_add yv zv) (poly_neg onep) onep (poly_neg onep);
    transitivity (poly_add (poly_add yv zv) (poly_neg onep))
                 (poly_add onep (poly_neg onep)) (poly_zero #t);
    divides_zero #(polynomial t) #cr_p r;
    symmetry #(polynomial t) #(cr_p.cr_r.r_add.acg_eq)
             (poly_add (poly_add yv zv) (poly_neg onep)) (poly_zero #t);
    divides_congruence_right #(polynomial t) #cr_p r
      (poly_zero #t) (poly_add (poly_add yv zv) (poly_neg onep));
    (* r | (neg yv) + ((yv+zv) - one) *)
    divides_add #(polynomial t) #cr_p r (poly_neg yv)
      (poly_add (poly_add yv zv) (poly_neg onep));
    (* residue identity:  zv - one  ~  (neg yv) + ((yv+zv) - one) *)
    residue_id #(polynomial t) #cr_p yv zv onep;
    symmetry #(polynomial t) #(cr_p.cr_r.r_add.acg_eq)
      (poly_add zv (poly_neg onep))
      (poly_add (poly_neg yv) (poly_add (poly_add yv zv) (poly_neg onep)));
    divides_congruence_right #(polynomial t) #cr_p r
      (poly_add (poly_neg yv) (poly_add (poly_add yv zv) (poly_neg onep)))
      (poly_add zv (poly_neg onep));
    poly_sub_reveal zv onep;                                 (* poly_sub zv one == add zv (neg one) *)
    (* now r | poly_sub zv one;  conclude the two ac_eq via ac_eq_divides *)
    ac_eq_divides (ac_mul (ac_inv x) x) (ac_one #t #f #r);   (* zv = poly_mul br a *)
    (* first form: poly_mul a br ~ zv, transport divisibility *)
    poly_mul_commutativity a br;                             (* poly_mul a br ~ poly_mul br a = zv *)
    reflexivity #(polynomial t) #(cr_p.cr_r.r_add.acg_eq) (poly_neg onep);
    poly_add_congruence (poly_mul a br) (poly_neg onep) zv (poly_neg onep);
    symmetry #(polynomial t) #(cr_p.cr_r.r_add.acg_eq)
      (poly_add (poly_mul a br) (poly_neg onep)) (poly_add zv (poly_neg onep));
    poly_sub_reveal (poly_mul a br) onep;
    divides_congruence_right #(polynomial t) #cr_p r
      (poly_add zv (poly_neg onep)) (poly_add (poly_mul a br) (poly_neg onep));
    ac_eq_divides (ac_mul x (ac_inv x)) (ac_one #t #f #r)

(* ================================================================ *)
(*  Inverse respects the quotient equality (inverse is unique).      *)
(*  Standard argument: ia = ia*1 = ia*(b*ib) = (ia*b)*ib             *)
(*                        = (ia*a)*ib = 1*ib = ib.                    *)
(* ================================================================ *)

let ac_inv_congr (#t:Type) {| f: field t |} (#r: polynomial t {Some? (poly_deg r)})
  (a b: algebraic t r)
  : Lemma (requires poly_irreducible r /\
                    not (ac_eq a (ac_zero #t #f #r)) /\
                    not (ac_eq b (ac_zero #t #f #r)) /\
                    ac_eq a b)
          (ensures  ac_eq (ac_inv a) (ac_inv b))
  = let ia = ac_inv a in
    let ib = ac_inv b in
    let o  = ac_one #t #f #r in
    ac_eq_reflexivity ia;
    ac_eq_reflexivity ib;
    ac_inv_correct a;                         (* ac_eq (ac_mul ia a) o *)
    ac_inv_correct b;                         (* ac_eq (ac_mul b ib) o *)
    (* ia ~ ia*1 *)
    ac_mul_one ia;
    ac_eq_symmetry (ac_mul ia o) ia;          (* ac_eq ia (ac_mul ia o) *)
    (* 1 ~ b*ib *)
    ac_eq_symmetry (ac_mul b ib) o;           (* ac_eq o (ac_mul b ib) *)
    ac_mul_congruence ia o ia (ac_mul b ib);  (* ac_eq (ia*1) (ia*(b*ib)) *)
    ac_eq_transitivity ia (ac_mul ia o) (ac_mul ia (ac_mul b ib));
    (* ia*(b*ib) ~ (ia*b)*ib *)
    ac_mul_associativity ia b ib;             (* ac_eq ((ia*b)*ib) (ia*(b*ib)) *)
    ac_eq_symmetry (ac_mul (ac_mul ia b) ib) (ac_mul ia (ac_mul b ib));
    ac_eq_transitivity ia (ac_mul ia (ac_mul b ib)) (ac_mul (ac_mul ia b) ib);
    (* (ia*b)*ib ~ (ia*a)*ib  (since b ~ a) *)
    ac_eq_symmetry a b;                       (* ac_eq b a *)
    ac_mul_congruence ia b ia a;              (* ac_eq (ia*b) (ia*a) *)
    ac_mul_congruence (ac_mul ia b) ib (ac_mul ia a) ib;
    ac_eq_transitivity ia (ac_mul (ac_mul ia b) ib) (ac_mul (ac_mul ia a) ib);
    (* (ia*a)*ib ~ 1*ib *)
    ac_mul_congruence (ac_mul ia a) ib o ib;  (* ac_eq ((ia*a)*ib) (o*ib) *)
    ac_eq_transitivity ia (ac_mul (ac_mul ia a) ib) (ac_mul o ib);
    (* 1*ib ~ ib *)
    ac_mul_one ib;                            (* ac_eq (ac_mul o ib) ib (second clause) *)
    ac_eq_transitivity ia (ac_mul o ib) ib

(* ================================================================ *)
(*  Assembly:  algebraic t r is a FIELD when r is irreducible.      *)
(* ================================================================ *)

(* 1 <> 0 in the quotient: else r | 1, contradicting irreducibility. *)
let ac_one_ne_zero (#t:Type) {| f: field t |}
  (r: polynomial t {Some? (poly_deg r) /\ poly_irreducible r})
  : Lemma (not (ac_eq (ac_one #t #f #r) (ac_zero #t #f #r)))
  = ac_eq_zero_iff_divides (ac_one #t #f #r);
    ac_one_rep #t #f #r;
    r_not_divides_one #t #f r

let algebraic_mig (#t:Type) {| f: field t |}
  (r: polynomial t {Some? (poly_deg r) /\ poly_irreducible r})
  : mul_is_group (algebraic t r) #((algebraic_commutative_ring #t #f #r).cr_r)
  = {
      inv             = (fun x  -> algebraic_ring_reveal #t #f #r; ac_inv #t #f #r x);
      inv_congr       = (fun aa bb -> algebraic_ring_reveal #t #f #r; ac_inv_congr #t #f #r aa bb);
      inversion_lemma = (fun x  -> algebraic_ring_reveal #t #f #r; ac_inv_correct #t #f #r x);
    }

let algebraic_field (#t:Type) {| f: field t |}
  (r: polynomial t {Some? (poly_deg r) /\ poly_irreducible r})
  : field (algebraic t r)
  = ac_one_ne_zero #t #f r;
    algebraic_ring_reveal #t #f #r;
    let one_ne_zero : squash (not (ac_eq (ac_one #t #f #r) (ac_zero #t #f #r))) = () in
    {
      f_sf          = { sf_r = (algebraic_commutative_ring #t #f #r).cr_r;
                        sf_mig = algebraic_mig #t #f r };
      f_mic         = (algebraic_commutative_ring #t #f #r).cr_mic;
      f_one_ne_zero = one_ne_zero;
    }
